{
  "name": "PULSE — Scheduled Traffic Monitor",
  "nodes": [
    {
      "parameters": { "content": "## Scheduled Traffic Monitor\n**Purpose:** periodically normalize externally supplied traffic events without mixing them with official incidents.\n**Input:** schedule; optional provider nodes may be inserted before normalization.\n**Output:** externalEvents with source and freshness.\n**Credentials:** optional `PULSE TomTom Traffic` or Google Routes.\n**Dependencies:** Data Sync persists the normalized output.\n**Failure path:** emits an empty successful scan when no provider is configured.", "height": 300, "width": 470 },
      "id": "d0000000-0000-4000-8000-000000000001", "name": "Workflow Documentation", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [-500, -300]
    },
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] } },
      "id": "d0000000-0000-4000-8000-000000000002", "name": "Every 15 Minutes", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-260, 80]
    },
    {
      "parameters": { "jsCode": "const raw=Array.isArray($json.events)?$json.events:[];const externalEvents=raw.slice(0,500).map((event,index)=>({id:String(event.id??`external-${Date.now()}-${index}`),title:String(event.title??event.description??'Evento vial externo').slice(0,180),description:String(event.description??'').slice(0,800),location:event.location,status:event.status??'unknown',sourceType:'external',provider:event.provider??$env.TRAFFIC_PROVIDER??'not_configured',sourceUpdatedAt:event.sourceUpdatedAt??new Date().toISOString()})).filter((event)=>Number.isFinite(Number(event.location?.lat))&&Number.isFinite(Number(event.location?.lng)));return[{json:{ok:true,externalEvents,count:externalEvents.length,provider:$env.TRAFFIC_PROVIDER??'not_configured',generatedAt:new Date().toISOString()}}];" },
      "id": "d0000000-0000-4000-8000-000000000003", "name": "Normalize External Traffic Events", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [20, 80]
    }
  ],
  "connections": { "Every 15 Minutes": { "main": [[{ "node": "Normalize External Traffic Events", "type": "main", "index": 0 }]] } },
  "settings": { "executionOrder": "v1" }, "active": false, "versionId": "d0000000-0000-4000-8000-000000000099"
}
