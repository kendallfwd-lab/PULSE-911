# La aplicación funciona por defecto sin servicios externos.
VITE_PULSE_AI_ENABLED=false
VITE_PULSE_DATA_MODE=local
VITE_N8N_BASE_URL=

# Ejemplo conectado:
# VITE_PULSE_AI_ENABLED=true
# VITE_PULSE_DATA_MODE=n8n
# VITE_N8N_BASE_URL=https://n8n.example.com

# Los proveedores con secretos se configuran exclusivamente en n8n.
# No agregue claves de Google, LLM, TomTom u otros proveedores en variables VITE_*.
